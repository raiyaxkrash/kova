{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kova",
  "version": "0.1.1",
  "identifier": "app.kova.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kova",
        "width": 980,
        "height": 640,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Kova — единый лаунчер для Windows-утилит",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
